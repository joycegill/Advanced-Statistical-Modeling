CHG2AT3 = `COST1_2024.Published in-state tuition 2024-25`,
CHG3AT3 = `COST1_2024.Published out-of-state tuition 2024-25`,
STUFACR = `EF2024D.Student-to-faculty ratio`,
ENRTOT = `DRVEF2024.Total  enrollment`,
EFUG1ST = `DRVEF2024.First-time degree/certificate-seeking undergraduate enrollment`,
EFUGTRN = `DRVEF2024.Transfer-in degree/certificate-seeking undergraduate enrollment`,
EFUGCNT = `DRVEF2024.Continuing degree/certificate-seeking undergraduate enrollment`,
RMINSTTP = `DRVEF2024.Percent of first-time undergraduates - in-state`,
RMOUSTTP = `DRVEF2024.Percent of first-time undergraduates - out-of-state`,
RMFRGNCP = `DRVEF2024.Percent of first-time undergraduates - foreign countries`,
RMUNKNWP = `DRVEF2024.Percent of first-time undergraduates - residence unknown`,
EFTOTAL = `EF2024.Grand total`,
EFFT = `EF2024.Full time total`,
EFFTMEN = `EF2024.Total men`,
EFFTWOM = `EF2024.Total women`,
EFAIANT = `EF2024A.American Indian or Alaska Native total`,
EFASIAT = `EF2024A.Asian total`,
EFBKAAT = `EF2024A.Black or African American total`,
EFHISPT = `EF2024A.Hispanic total`,
EFNHPIT = `EF2024A.Native Hawaiian or Other Pacific Islander total`,
EFWHITT = `EF2024A.White total`,
EF2MORT = `EF2024A.Two or more races total`,
EFUNKNT = `EF2024A.Race/ethnicity unknown total`,
EFNRALT = `EF2024A.U.S. Nonresident total`,
EFGNDRUA = `EF2024A.Total of gender unknown and another gender`,
EFGNDRKN = `EF2024A.Total gender reported as one of the mutually exclusive binary categories (Men/Women)`,
UAGRNTP = `SFA2324.Percent of undergraduate students awarded federal, state, local, institutional or other sources of grant aid`,
AGRNT_T = `SFA2324.Total amount of federal, state, local or institutional grant aid awarded to full-time first-time undergraduates`,
UFLOANN = `SFA2324.Number of undergraduate students awarded federal student loans`,
